FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=./auth.db

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email verification is required by default. The application never stores
# the OTP itself; it stores only a salted hash and expiry metadata.
EMAIL_VERIFICATION_REQUIRED=true
# Resolves the email domain before sending. This cannot prove a mailbox exists;
# the OTP is still required to prove that the user controls the address.
EMAIL_DOMAIN_CHECK=true

# ZeroBounce validation runs before a local signup creates a user or sends an
# OTP. Keep the API key server-side and never expose it to the frontend.
ZEROBOUNCE_REQUIRED=true
ZEROBOUNCE_API_KEY=
ZEROBOUNCE_API_URL=https://api-us.zerobounce.net/v2/validate
ZEROBOUNCE_TIMEOUT_SECONDS=30

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
